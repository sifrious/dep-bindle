{
    "name": "maryeperry/bindle",
    "description": "Dev-only Laravel package that screenshots every page, enumerates components and props across Blade/Livewire/Alpine/Vue/React/Svelte, stores the graph in SQLite, and emits Markdown docs from a phrase dictionary.",
    "keywords": ["laravel", "dusk", "audit", "screenshots", "blade", "livewire", "inertia", "documentation"],
    "license": "MIT",
    "authors": [
        {
            "name": "Mary Perry",
            "email": "mmebyte@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-sqlite3": "*",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "laravel/dusk": "^8.0|^9.0",
        "nikic/php-parser": "^5.0",
        "symfony/css-selector": "^7.0|^8.0",
        "symfony/dom-crawler": "^7.0|^8.0"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/pint": "^1.24.0",
        "livewire/livewire": "^3.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "peckphp/peck": "^0.1.3",
        "pestphp/pest": "^4.1.0",
        "pestphp/pest-plugin-laravel": "^4.0|^3.0",
        "phpstan/phpstan": "^2.1.26",
        "rector/rector": "^2.1.7",
        "symfony/var-dumper": "^7.3.3"
    },
    "autoload": {
        "psr-4": {
            "Maryeperry\\Bindle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maryeperry\\Bindle\\BindleServiceProvider"
            ],
            "aliases": {
                "Bindle": "Maryeperry\\Bindle\\Facades\\Bindle"
            }
        }
    },
    "scripts": {
        "lint": "pint",
        "refactor": "rector",
        "test:typos": "peck",
        "test:lint": "pint --test",
        "test:unit": "pest",
        "test:types": "phpstan",
        "test:refactor": "rector --dry-run",
        "test": [
            "@test:lint",
            "@test:typos",
            "@test:unit",
            "@test:types",
            "@test:refactor"
        ]
    }
}
